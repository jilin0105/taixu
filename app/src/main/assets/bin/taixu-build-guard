#!/bin/sh
# Lightweight console/Agent guard. The authoritative preflight is
# /opt/taixu/scripts/taixu-build.sh.
set -u
command_name="${1:-help}"
[ "$#" -gt 0 ] && shift
GRADLE_HOME=/opt/gradle-8.14.2
BUILD_ENGINE=/opt/taixu/scripts/taixu-build.sh
fail() { printf '%s\n' "==> [TaiXu Guard] ❌ $*" >&2; exit "${2:-125}"; }
load_android_environment() {
    if [ -f /etc/profile.d/taixu-android.sh ]; then . /etc/profile.d/taixu-android.sh; fi
    export ANDROID_HOME="${ANDROID_HOME:-/opt/android-sdk}"
    export ANDROID_SDK_ROOT="${ANDROID_SDK_ROOT:-$ANDROID_HOME}"
    export TAIXU_AAPT2_PATH="${TAIXU_AAPT2_PATH:-$ANDROID_HOME/build-tools/35.0.0/aapt2}"
}
is_android_project() {
    [ -f pubspec.yaml ] && [ -d android ] && return 0
    [ -f local.properties ] && return 0
    for file in build.gradle build.gradle.kts settings.gradle settings.gradle.kts app/build.gradle app/build.gradle.kts; do
        [ -f "$file" ] || continue
        grep -Eq 'com\.android\.(application|library)|^[[:space:]]*android[[:space:]]*\{' "$file" 2>/dev/null && return 0
    done
    return 1
}
is_information_only() {
    [ "$#" -eq 0 ] && return 0
    for argument in "$@"; do
        case "$argument" in -v|--version|-h|--help|help|tasks|properties|projects|dependencies|dependencyInsight|components|model|-*) ;; *) return 1 ;; esac
    done
    return 0
}
doctor_arm_project() {
    [ -x "$BUILD_ENGINE" ] || fail "构建自检入口不存在：$BUILD_ENGINE"
    /bin/sh "$BUILD_ENGINE" doctor "$PWD" || exit $?
    load_android_environment
}
exec_fixed_gradle() {
    [ -x "$GRADLE_HOME/bin/gradle" ] || fail "缺少 TaiXu Gradle 8.14.2"
    export TAIXU_BUILD_GUARD_BYPASS=1
    "$GRADLE_HOME/bin/gradle" "$@"
}
verify_recent_apk() {
    verifier=/opt/taixu/scripts/taixu-build-verify.sh
    [ -x "$verifier" ] || fail "缺少 APK ABI 验证器"
    apk=$(find "$PWD" -type f -name '*.apk' ! -name '*unaligned*' -exec ls -t {} + 2>/dev/null | head -n 1)
    [ -n "$apk" ] || fail "构建完成但未找到 APK 产物"
    /bin/sh "$verifier" "$apk" || fail "APK 产物验证失败，拒绝继续"
}
run_gradle() {
    mode="$1"; shift
    for argument in "$@"; do
        [ "$argument" = "--offline" ] && export TAIXU_OFFLINE=1
    done
    if is_android_project && ! is_information_only "$@"; then
        doctor_arm_project
        exec_fixed_gradle "$@" --console=plain --no-daemon -Dorg.gradle.native=false -Pandroid.builder.sdkDownload=false "-Pandroid.aapt2FromMavenOverride=$TAIXU_AAPT2_PATH"
        status=$?
        [ "$status" -eq 0 ] || exit "$status"
        verify_recent_apk
        exit 0
    fi
    if [ "$mode" = gradlew ] && [ -x ./gradlew ]; then
        export TAIXU_BUILD_GUARD_BYPASS=1
        ./gradlew "$@"
        status=$?
        [ "$status" -eq 0 ] || exit "$status"
        is_android_project && ! is_information_only "$@" && verify_recent_apk
        exit 0
    fi
    exec_fixed_gradle "$@"
    exit $?
}
run_flutter() {
    for argument in "$@"; do
        [ "$argument" = "--offline" ] && export TAIXU_OFFLINE=1
    done
    [ -x /opt/flutter/bin/flutter ] || fail "Flutter SDK 未安装"
    if [ "${1:-}" = build ]; then
        case "${2:-}" in
            apk|appbundle)
                doctor_arm_project
                has_target=0
                for argument in "$@"; do case "$argument" in --target-platform|--target-platform=*) has_target=1 ;; esac; done
                export TAIXU_BUILD_GUARD_BYPASS=1
                if [ "$has_target" -eq 0 ]; then
                    printf '%s\n' '==> [TaiXu Guard] 未指定 APK ABI，强制使用 android-arm64'
                    /opt/flutter/bin/flutter "$@" --target-platform android-arm64
                else
                    /opt/flutter/bin/flutter "$@"
                fi
                status=$?
                [ "$status" -eq 0 ] || exit "$status"
                verify_recent_apk
                exit 0
                ;;
        esac
    fi
    export TAIXU_BUILD_GUARD_BYPASS=1
    exec /opt/flutter/bin/flutter "$@"
}
case "$command_name" in
    gradle|gradlew) run_gradle "$command_name" "$@" ;;
    flutter) run_flutter "$@" ;;
    taixu-build) exec /bin/sh "$BUILD_ENGINE" "$@" ;;
    help|-h|--help) printf '%s\n' 'TaiXu 控制台构建入口：' '  gradle/gradlew <任务>                       Android 工程自动先自检' '  flutter build apk|appbundle                 自动先自检并默认 arm64' '  taixu-build doctor <项目目录>               只执行环境自检' '  taixu-build android <项目> <任务> [--qemu]  App 专用构建入口' ;;
    *) fail "未知入口：$command_name" ;;
esac
