[
  {
    "schemaVersion": 1,
    "id": "claude-code",
    "name": "Claude Code",
    "description": "Anthropic 官方 Agent 编程助手 CLI，支持沙箱内代码全自动探索与工程演进。",
    "dependencies": ["node>=20.0.0", "curl", "ca-certificates", "git"],
    "launchType": "pty",
    "version": "1.0.0",
    "latestVersion": "1.0.0",
    "publisher": "Anthropic",
    "category": "CODING_AGENT",
    "architectures": ["ARM64"],
    "installMethod": "NPM",
    "installScript": "npm_config_prefix=\"$TAIXU_TOOL_DIR\" npm install -g --ignore-scripts @anthropic-ai/claude-code --registry=https://registry.npmmirror.com || npm_config_prefix=\"$TAIXU_TOOL_DIR\" npm install -g --ignore-scripts @anthropic-ai/claude-code\nmkdir -p \"$TAIXU_TOOL_DIR/bin\"\nprintf '#!/usr/bin/env sh\\nMODULE_DIR=\"$(cd \"$(dirname \"$0\")/../lib/node_modules/@anthropic-ai/claude-code\" && pwd)\"\\nif [ -f \"$MODULE_DIR/cli-wrapper.cjs\" ]; then\\n    exec node \"$MODULE_DIR/cli-wrapper.cjs\" \"$@\"\\nelif [ -f \"$MODULE_DIR/cli.js\" ]; then\\n    exec node \"$MODULE_DIR/cli.js\" \"$@\"\\nelse\\n    exec node \"$MODULE_DIR/index.js\" \"$@\"\\nfi\\n' > \"$TAIXU_TOOL_DIR/bin/claude\"\nchmod +x \"$TAIXU_TOOL_DIR/bin/claude\"",
    "launchCommand": "claude",
    "verifyCommand": "claude --version",
    "commandLinks": ["claude"],
    "environment": {
      "CLAUDE_CONFIG_DIR": "/opt/taixu/data/claude-code"
    }
  },
  {
    "schemaVersion": 1,
    "id": "openclaw",
    "name": "OpenClaw",
    "description": "面向自动化工作流与本地 Agent 驱动的太墟中枢工具。",
    "dependencies": ["node>=22.22.3", "curl", "ca-certificates", "git"],
    "launchType": "web",
    "servicePort": 18789,
    "servicePath": "/",
    "version": "0.1.0",
    "latestVersion": "0.1.0",
    "publisher": "OpenClaw",
    "category": "AI_AGENT",
    "architectures": ["ARM64"],
    "permissions": ["NETWORK", "WORKSPACE_READ", "WORKSPACE_WRITE", "LOCAL_WEB"],
    "installMethod": "SCRIPT",
    "launchCommand": "openclaw gateway --allow-unconfigured",
    "verifyCommand": "openclaw --version",
    "commandLinks": ["openclaw"],
    "environment": {
      "OPENCLAW_HOME": "/opt/taixu/data/openclaw",
      "XDG_CONFIG_HOME": "/opt/taixu/data/openclaw"
    }
  },
  {
    "schemaVersion": 1,
    "id": "base-devtools",
    "name": "基础开发加速包 (DevTools)",
    "description": "一键预装 ripgrep、fd、jq、tmux 等高性能代码检索与终端开发工具链。",
    "dependencies": ["curl", "ca-certificates"],
    "launchType": "one_shot",
    "version": "1.0.0",
    "latestVersion": "1.0.0",
    "publisher": "TaiXu",
    "category": "DEVELOPER_TOOL",
    "architectures": ["ARM64"],
    "permissions": ["NETWORK", "WORKSPACE_READ", "WORKSPACE_WRITE"],
    "installMethod": "APT",
    "installScript": "rm -rf /var/lib/dpkg/updates/* /var/lib/dpkg/lock* /var/lib/apt/lists/lock /var/cache/apt/archives/lock 2>/dev/null || true; DEBIAN_FRONTEND=noninteractive dpkg --configure -a 2>/dev/null || true; DEBIAN_FRONTEND=noninteractive apt-get update -y && DEBIAN_FRONTEND=noninteractive apt-get install -y --no-install-recommends ripgrep fd-find jq tmux",
    "launchCommand": "rg --version",
    "verifyCommand": "rg --version",
    "commandLinks": ["rg", "fdfind", "jq", "tmux"]
  },
  {
