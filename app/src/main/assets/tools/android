#!/usr/bin/env sh
# ==============================================================================
# Google Android CLI & Agent Toolchain for TaiXu (LinuxAIRuntime)
# Reference: https://developer.android.com/tools/agents
# ==============================================================================

set -e

export JAVA_HOME="${JAVA_HOME:-/usr/lib/jvm/java-17-openjdk-arm64}"
export ANDROID_HOME="${ANDROID_HOME:-/opt/android-sdk}"
export ANDROID_SDK_ROOT="${ANDROID_SDK_ROOT:-/opt/android-sdk}"
export PATH="$JAVA_HOME/bin:/opt/gradle-8.7/bin:$TAIXU_TOOL_DIR/bin:/usr/local/bin:/usr/bin:/bin:$PATH"

show_help() {
    cat << 'EOF'
Android CLI (Google Android Tools & Agent Suite)
Reference: https://developer.android.com/tools/agents

Usage: android <command> [arguments...]

Commands:
  doctor              Check local Android development & agent runtime environment
  init <name>         Scaffold a new Jetpack Compose modern Android project
  build [variant]     Assemble Android project using local Gradle (default: debug)
  run                 Build and install APK directly to host device (ADB / PackageInstaller)
  skills              List available Android Agent skills (Compose, R8, AGP, etc.)
  version, --version  Show Android CLI version information

EOF
}

cmd_doctor() {
    echo "=== Android CLI Environment Diagnostic ==="
    echo -n "1. Java (OpenJDK 17+): "
    if command -v java >/dev/null 2>&1; then
        java -version 2>&1 | head -n 1
    else
        echo "NOT FOUND (Please install openjdk-17-jdk-headless)"
    fi

    echo -n "2. Gradle: "
    if command -v gradle >/dev/null 2>&1; then
        gradle -v 2>&1 | grep "Gradle " || echo "Installed"
    else
        echo "NOT FOUND (/opt/gradle-8.7/bin/gradle)"
    fi

    echo -n "3. AAPT (Android Asset Packaging Tool): "
    if command -v aapt >/dev/null 2>&1; then
        echo "Installed ($(which aapt))"
    else
        echo "NOT FOUND"
    fi

    echo -n "4. ADB (Android Debug Bridge): "
    if command -v adb >/dev/null 2>&1; then
        echo "Installed ($(which adb))"
    else
        echo "NOT FOUND"
    fi

    echo -n "5. Host Bridge (127.0.0.1:7980): "
    if curl -s -m 2 http://127.0.0.1:7980/health >/dev/null 2>&1; then
        echo "Connected & Ready"
    else
        echo "Standby / Native FileProvider Mode"
    fi
    echo "=========================================="
}

cmd_init() {
    PROJECT_NAME="${1:-MyApplication}"
    PKG_NAME="com.example.$(echo "$PROJECT_NAME" | tr '[:upper:]' '[:lower:]' | tr -cd '[:alnum:]')"
    echo "Scaffolding Jetpack Compose Android project '$PROJECT_NAME' (Package: $PKG_NAME)..."
    
    mkdir -p "$PROJECT_NAME/app/src/main/java/${PKG_NAME//.//}"
    mkdir -p "$PROJECT_NAME/app/src/main/res/values"
    mkdir -p "$PROJECT_NAME/gradle/wrapper"

    # settings.gradle.kts
    cat << EOF > "$PROJECT_NAME/settings.gradle.kts"
pluginManagement {
    repositories {
        google()
        mavenCentral()
        gradlePluginPortal()
    }
}
dependencyResolutionManagement {
    repositoriesMode.set(RepositoriesMode.FAIL_ON_PROJECT_REPOS)
    repositories {
        google()
        mavenCentral()
    }
}
rootProject.name = "$PROJECT_NAME"
include(":app")
EOF

    # build.gradle.kts
    cat << 'EOF' > "$PROJECT_NAME/build.gradle.kts"
plugins {
    alias(libs.plugins.android.application) apply false
    alias(libs.plugins.kotlin.android) apply false
    alias(libs.plugins.kotlin.compose) apply false
}
EOF

    # gradle.properties
    cat << 'EOF' > "$PROJECT_NAME/gradle.properties"
org.gradle.jvmargs=-Xmx2048m -Dfile.encoding=UTF-8
android.useAndroidX=true
android.nonTransitiveRClass=true
android.aapt2FromMaven=false
android.overrideAapt2Path=/usr/bin/aapt
EOF

    echo "Project '$PROJECT_NAME' successfully initialized!"
}

cmd_build() {
    VARIANT="${1:-assembleDebug}"
    if [ -f "./gradlew" ]; then
        chmod +x ./gradlew
        ./gradlew "$VARIANT"
    elif command -v gradle >/dev/null 2>&1; then
        gradle "$VARIANT"
    else
        echo "Error: No Gradle wrapper or system Gradle found."
        exit 1
    fi
}

cmd_run() {
    cmd_build "assembleDebug"
    APK_FILE=$(find app/build/outputs/apk/debug -name "*.apk" 2>/dev/null | head -n 1)
    if [ -n "$APK_FILE" ] && [ -f "$APK_FILE" ]; then
        echo "Exporting APK to /sdcard/Download..."
        mkdir -p /sdcard/Download 2>/dev/null || true
        cp -f "$APK_FILE" /sdcard/Download/ 2>/dev/null || true
        if command -v adb >/dev/null 2>&1; then
            adb install -r "$APK_FILE" 2>/dev/null || true
        fi
        echo "APK Ready: $APK_FILE"
    else
        echo "Error: APK not found after build."
        exit 1
    fi
}

case "$1" in
    doctor)
        cmd_doctor
        ;;
    init)
        shift
        cmd_init "$@"
        ;;
    build)
        shift
        cmd_build "$@"
        ;;
    run)
        cmd_run
        ;;
    skills)
        echo "Official Android Agent Skills:"
        echo "  - compose-migration: Guidance on migrating Views to Jetpack Compose"
        echo "  - r8-audit: Proguard/R8 optimization and keep rules audit"
        echo "  - agp-upgrade: Upgrade Android Gradle Plugin and Kotlin versions"
        echo "  - navigation3-setup: Type-safe Navigation 3 architecture setup"
        ;;
    version|--version|-v)
        echo "Android CLI v1.0.0 (Google Android Tools & Agent Suite - LinuxAIRuntime)"
        ;;
    *)
        show_help
        ;;
esac
