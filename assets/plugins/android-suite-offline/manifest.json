{
  "schemaVersion": 1,
  "id": "android-suite-offline",
  "name": "Android 全栈开发套件（ARM64 离线版）",
  "description": "仅面向 Android APK 编译的 ARM64 离线开发套件，内置 JDK、Android SDK、Build-Tools、AAPT2、NDK、Gradle、CMake、Ninja 和 Flutter；不包含 Web、iOS 或桌面平台构建资源",
  "version": "1.0.7",
  "latestVersion": "1.0.7",
  "enabled": true,
  "publisher": "TaiXu",
  "category": "DEVELOPER",
  "launchType": "command",
  "architectures": ["ARM64"],
  "permissions": ["WORKSPACE_READ", "WORKSPACE_WRITE"],
  "updateStrategy": "REINSTALL",
  "source": "LOCAL",
  "offlineOnly": true,
  "installMethod": "LOCAL_PACKAGE",
  "installSteps": [
    "/bin/sh \"$TAIXU_PLUGIN_PAYLOAD/scripts/install-android-suite.sh\""
  ],
  "uninstallSteps": [
    "/bin/sh \"$TAIXU_PLUGIN_PAYLOAD/scripts/uninstall-android-suite.sh\""
  ],
  "launchCommand": "gradle --version",
  "verifyCommand": "/bin/sh \"$TAIXU_PLUGIN_PAYLOAD/scripts/verify-android-suite.sh\"",
  "commandLinks": ["java", "javac", "gradle", "cmake", "ninja", "adb", "flutter", "dart"],
  "environment": {
    "ANDROID_HOME": "/opt/android-sdk",
    "ANDROID_SDK_ROOT": "/opt/android-sdk",
    "GRADLE_HOME": "/opt/gradle-8.14.2",
    "JAVA_HOME": "/opt/taixu/toolchains/android/jdk",
    "ANDROID_NDK_HOME": "/opt/taixu/toolchains/android/ndk",
    "PATH": "/opt/taixu/bin:/opt/taixu/tools/android-suite-offline/bin:/opt/taixu/toolchains/android/jdk/bin:/opt/gradle-8.14.2/bin:$PATH"
  }
}
