{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://taixu.local/schema/project-template-v1.json",
  "title": "TaiXu Project Template Manifest v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "id", "name", "version"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "id": { "type": "string", "pattern": "^[a-z0-9]+(?:[._-][a-z0-9]+)*$", "not": { "pattern": "^builtin\\." } },
    "name": { "type": "string", "minLength": 1 },
    "version": { "type": "string", "minLength": 1 },
    "description": { "type": "string", "default": "" },
    "projectType": { "enum": ["ANDROID", "FLUTTER", "GENERAL"], "default": "GENERAL" },
    "category": { "$ref": "#/$defs/category" },
    "previewImage": { "type": "string", "default": "" },
    "previews": { "type": "array", "items": { "$ref": "#/$defs/preview" }, "maxItems": 2, "default": [] },
    "variables": { "type": "array", "items": { "$ref": "#/$defs/variable" }, "default": [] },
    "hooks": { "$ref": "#/$defs/hooks" }
  },
  "$defs": {
    "category": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z0-9]+(?:[._-][a-z0-9]+)*$", "default": "general" },
        "name": { "type": "string", "default": "General" },
        "sortOrder": { "type": "integer", "default": 0 }
      }
    },
    "preview": {
      "type": "object",
      "additionalProperties": false,
      "required": ["device", "path"],
      "properties": { "device": { "enum": ["PHONE", "TABLET"] }, "path": { "type": "string", "minLength": 1 } }
    },
    "option": {
      "type": "object",
      "additionalProperties": false,
      "required": ["value"],
      "properties": { "value": { "type": "string" }, "label": { "type": "string", "default": "" } }
    },
    "variable": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name"],
      "properties": {
        "name": { "type": "string", "pattern": "^[A-Za-z][A-Za-z0-9_]*$" },
        "label": { "type": "string", "default": "" },
        "description": { "type": "string", "default": "" },
        "prompt": { "type": "boolean", "default": false },
        "inputType": { "enum": ["TEXT", "MULTILINE", "NUMBER", "BOOLEAN", "SELECT", "SECRET"], "default": "TEXT" },
        "placeholder": { "type": "string", "default": "" },
        "options": { "type": "array", "items": { "$ref": "#/$defs/option" }, "default": [] },
        "required": { "type": "boolean", "default": true },
        "defaultValue": { "type": "string", "default": "" },
        "validationRegex": { "type": "string", "default": "" }
      }
    },
    "hooks": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "beforeCreate": { "type": "string", "pattern": "^(|template-hooks/[^/].*)$", "default": "" },
        "afterCreate": { "type": "string", "pattern": "^(|template-hooks/[^/].*)$", "default": "" }
      }
    }
  }
}
